{
  "name": "gearin-backend",
  "version": "1.0.0",
  "description": "Monolitic Backend for GearIN",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "server": "node server.js",
    "start": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:gateway": "cross-env TEST_VIA_GATEWAY=1 npm test"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testTimeout": 120000,
    "silent": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "app.js",
      "config/**/*.js",
      "controllers/**/*.js",
      "helpers/**/*.js",
      "middlewares/**/*.js",
      "models/**/*.js",
      "routes/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Code-Flaps/GearIN-Monolithic.git"
  },
  "author": "Code-Flaps-Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Code-Flaps/GearIN-Monolithic/issues"
  },
  "homepage": "https://github.com/Code-Flaps/GearIN-Monolithic#readme",
  "dependencies": {
    "@sendgrid/mail": "^7.7.0",
    "bcrypt": "^5.1.0",
    "braintree": "^3.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.1.1",
    "morgan": "^1.10.0",
    "nodemon": "^2.0.22",
    "react-icons": "^4.8.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
