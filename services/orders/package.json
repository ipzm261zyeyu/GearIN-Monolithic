{
  "name": "gearin-orders",
  "version": "1.0.0",
  "description": "Orders service for GearIN",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate-orders.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testTimeout": 120000,
    "silent": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "mongoose": "^8.24.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
