{
  "name": "gearin-gateway",
  "version": "1.0.0",
  "description": "API gateway for GearIN",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "silent": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ]
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "http-proxy-middleware": "^4.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
